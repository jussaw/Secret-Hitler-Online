# Settings for devops/backup-db.sh and devops/restore-db.sh. Copy this file to devops/.env (which
# git ignores) and set BACKUP_DIR. Each line is NAME=value; one pair of quotes around a value is
# removed, and nothing in the file is run. A variable already set in the environment wins over
# this file, and an empty value means the default. ENV_FILE=/path/to/other.env reads another file.

# The directory that keeps the backups: an existing directory, as an absolute path. Required.
BACKUP_DIR=/path/to/backups

# The running server's container (both scripts).
#CONTAINER_NAME=secret-hitler-online

# The database file inside the container: the image's DATABASE_PATH (both scripts).
#DB_PATH=/data/backup.db

# Backups older than this many days are deleted after each backup (a whole number, at least 1).
#RETENTION_DAYS=30

# A command run after each backup, with the new backup's path as $1, through sh -c. A backup kept
# only on this host is lost with it, so this is the place to copy each one elsewhere. If the
# command fails, the backup is kept and the script exits non-zero. Empty: no hook.
#AFTER_BACKUP=cp "$1" "$1.sha256" /path/to/another/disk/

# How long the restore waits for the server to start again, in seconds (a whole number, at
# least 1).
#STARTUP_TIMEOUT_SECONDS=120
